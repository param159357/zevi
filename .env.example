# Copy to .env.local and fill in. Never commit .env.local.
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle — treat it as public.

# --- Supabase (required) ---------------------------------------------------
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (optional locally) -----------------------------------------------
# Absolute origin used to build the links in confirmation emails. Defaults to
# http://localhost:3000 in development and to VERCEL_URL when deployed.
#
# Whatever this resolves to, `<origin>/auth/callback` has to be on the project's
# redirect allow list: Supabase dashboard -> Authentication -> URL Configuration
# -> Redirect URLs (http://localhost:3000/** covers local work). Without it,
# Supabase drops the confirmation code on the Site URL instead.
# NEXT_PUBLIC_SITE_URL=


# --- Razorpay (required to assign a job) -----------------------------------
# Spec §4 charges the client at selection, so without these nobody can be
# picked. The shortlist says so rather than assigning jobs for free.
#
# Dashboard -> Account & Settings -> API Keys. Test keys (rzp_test_...) are
# free and are what local development should use.
#
# The key id is public: Razorpay Checkout needs it in the browser and it
# authorises nothing on its own. The secret never leaves the server.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# A DIFFERENT secret from the one above — you choose it when creating the
# webhook at Dashboard -> Settings -> Webhooks. Subscribe the endpoint
# <origin>/api/webhooks/razorpay to `payment.captured` and `payment.failed`.
#
# This is the backstop for a client who paid and then closed the tab: without
# it that job is charged for and never assigned. The route refuses every
# delivery while this is unset rather than trusting an unsigned body.
RAZORPAY_WEBHOOK_SECRET=


# --- Auto-accept sweep (required for deliveries to complete on time) -------
# Spec §5: a delivery is accepted automatically after 36 hours under ₹1,000 and
# 3 days at or above it, if the client says nothing. The clock is stored on the
# delivery row; this is the bearer token on the endpoint that reads it.
#
# Any long random string — `openssl rand -hex 32`. On Vercel, set it as an
# environment variable and the schedule in vercel.json sends it automatically;
# locally, call it yourself:
#
#   curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/auto-accept
#
# Without it the route refuses every request. An open endpoint that completes
# jobs and releases escrow is an open endpoint that pays people early.
CRON_SECRET=


# --- Not wired up yet ------------------------------------------------------
# Listed so the full set is discoverable. Add to src/lib/env.ts when each
# integration actually lands.

# Cloudflare R2 (file storage)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# Razorpay Route transfers (paying workers out). Needs a linked account per
# worker, which needs their KYC — spec §6 puts that before the first payout,
# so it lands with the payout flow, not here. Escrow is held on the platform
# account and recorded in escrow_holds meanwhile.

# SMS (mobile OTP at signup). Until one of these lands, development prints the
# code to the server console and production refuses to send.
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER_ID=

# Amazon SES (transactional email)
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_ADDRESS=

# Sentry (error monitoring)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
