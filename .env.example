# Copy to .env.local and fill in. Never commit .env.local.
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle — treat it as public.

# --- Supabase (required) ---------------------------------------------------
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# --- Not wired up yet ------------------------------------------------------
# Listed so the full set is discoverable. Add to src/lib/env.ts when each
# integration actually lands.

# Cloudflare R2 (file storage)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# Razorpay Route (payments + escrow + payouts)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Amazon SES (transactional email)
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_ADDRESS=

# Sentry (error monitoring)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
